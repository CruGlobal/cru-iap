{
  "name": "@cruglobal/cru-iap",
  "version": "0.1.0",
  "description": "Verify Google Identity-Aware Proxy assertion JWTs. TypeScript sibling of the cru_iap Ruby gem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CruGlobal/cru-iap.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
